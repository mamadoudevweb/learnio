# ==============================================================================
# Variables d'environnement pour Learnio
# Copier ce fichier en .env et adapter les valeurs selon votre environnement.
# Toutes les variables sont préfixées par LEARNIO_.
# ==============================================================================

# --- Environnement & Sécurité de base ---
# Environnements disponibles : development, testing, production
LEARNIO_ENV=development
LEARNIO_DEBUG=true

# Clés secrètes obligatoires (doivent être différentes et faire au moins 32 caractères)
# En production, l'application échoue au démarrage si elles sont absentes.
LEARNIO_SECRET_KEY=change-me-in-production-at-least-32-chars-long
LEARNIO_JWT_SECRET_KEY=change-me-too-in-production-at-least-32-chars-long

# --- Base de données ---
LEARNIO_DATABASE_URL=sqlite:///learnio.db

# --- Limitation de débit ---
LEARNIO_RATELIMIT_DEFAULT=200 per hour

# --- Stockage des fichiers ---
LEARNIO_UPLOAD_DIR=uploads
LEARNIO_MAX_FILE_SIZE_MB=25

# --- Email & Notifications ---
# Backends supportés : console, memory, smtp
LEARNIO_EMAIL_BACKEND=console
LEARNIO_EMAIL_FROM=noreply@learnio.app

# Paramètres SMTP (requis si LEARNIO_EMAIL_BACKEND=smtp)
LEARNIO_SMTP_HOST=localhost
LEARNIO_SMTP_PORT=587
LEARNIO_SMTP_USER=
LEARNIO_SMTP_PASSWORD=
LEARNIO_SMTP_USE_TLS=true
LEARNIO_SMTP_USE_SSL=false

# --- Sécurité & Jetons ---
# Durée de validité du jeton / code de réinitialisation de mot de passe (en minutes)
LEARNIO_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
